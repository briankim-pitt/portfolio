<folio-stack-controller hidden></folio-stack-controller>

<script>
  class FolioStackController extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const stack = this.closest('main');
      const intro = stack?.querySelector<HTMLElement>('[data-base-layer]');
      const dev = stack?.querySelector<HTMLElement>('.dev-work');
      const contact = stack?.querySelector<HTMLElement>('.contact-folio');
      if (!stack || !intro || !dev || !contact || !('ResizeObserver' in window)) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let frame = 0;
      let stopAt = 0;
      let cushion = 0;

      const render = () => {
        const remaining = stopAt - window.scrollY;
        let offset = 0;
        if (!reducedMotion.matches && cushion > 0 && Math.abs(remaining) < cushion) {
          // Blend normal scrolling into the pinned position with matching
          // velocities at both ends, instead of an abrupt sticky cutoff.
          const eased = (remaining + cushion) ** 2 / (4 * cushion);
          offset = eased - Math.max(remaining, 0);
        }
        dev.style.setProperty('--dev-stop-offset', `${offset.toFixed(3)}px`);
      };

      const schedule = () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          render();
        });
      };

      // Reserve the contact layer's full reading distance while its folder waits
      // at the bottom of the viewport. The containing block releases it only
      // after the Dev Work content has passed.
      const measure = () => {
        stack.style.setProperty('--intro-height', `${intro.offsetHeight}px`);
        stack.style.setProperty('--dev-height', `${dev.offsetHeight}px`);
        stack.style.setProperty('--contact-height', `${contact.offsetHeight}px`);
        stack.setAttribute('data-stack-ready', '');

        const stackTop = stack.getBoundingClientRect().top + window.scrollY;
        const devStyle = getComputedStyle(dev);
        const devStart = intro.offsetHeight + parseFloat(devStyle.marginTop);
        stopAt = stackTop + devStart - parseFloat(devStyle.top);
        cushion = Math.min(180, window.innerHeight * 0.2);
        render();
      };

      const observer = new ResizeObserver(measure);
      observer.observe(intro);
      observer.observe(dev);
      observer.observe(contact);
      measure();

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', measure);
      reducedMotion.addEventListener('change', schedule);

      this.cleanup = () => {
        cancelAnimationFrame(frame);
        observer.disconnect();
        window.removeEventListener('scroll', schedule);
        window.removeEventListener('resize', measure);
        reducedMotion.removeEventListener('change', schedule);
        stack.removeAttribute('data-stack-ready');
        stack.style.removeProperty('--intro-height');
        stack.style.removeProperty('--dev-height');
        stack.style.removeProperty('--contact-height');
        dev.style.removeProperty('--dev-stop-offset');
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('folio-stack-controller')) {
    customElements.define('folio-stack-controller', FolioStackController);
  }
</script>
