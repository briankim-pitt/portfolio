<intro-title aria-label="Fullstack Dev">
  <span class="fullstack" aria-hidden="true">FULLSTACK</span>
  <span class="dev" aria-hidden="true">DEV</span>
</intro-title>

<style>
  intro-title {
    position: absolute;
    z-index: 1;
    inset: clamp(8rem, 20svh, 12rem) var(--page-gutter) clamp(10rem, 22svh, 14rem);
    display: block;
    pointer-events: none;
    color: #000;
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.07em;
  }

  span {
    position: absolute;
    display: block;
    white-space: nowrap;
    will-change: transform;
  }

  .fullstack {
    top: 0;
    left: 0;
    font-size: 15.6vw;
    transform-origin: left top;
  }

  .dev {
    right: 0;
    bottom: 0;
    font-size: clamp(7rem, 25vw, 28rem);
    color: transparent;
    -webkit-text-stroke: clamp(1px, 0.14vw, 2.5px) #000;
    transform-origin: right bottom;
  }

  @keyframes fullstack-scroll {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(calc(var(--intro-width) * -0.2), 0, 0) scale(1.22); }
  }

  @keyframes dev-scroll {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(calc(var(--intro-width) * 0.24), 0, 0) scale(1.36); }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-native-intro]) .fullstack,
    :global([data-native-intro]) .dev {
      animation: fullstack-scroll auto linear both;
      animation-timeline: scroll(root block);
      animation-range: var(--intro-scroll-start) var(--intro-scroll-end);
    }

    :global([data-native-intro]) .dev {
      animation-name: dev-scroll;
    }
  }

  @media (max-width: 36rem) {
    intro-title {
      inset-block: 25svh 32svh;
    }

    .dev {
      font-size: 32vw;
    }
  }
</style>

<script>
  class IntroTitle extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const intro = this.closest<HTMLElement>('[data-base-layer]');
      const stack = intro?.parentElement;
      const fullstack = this.querySelector<HTMLElement>('.fullstack');
      const dev = this.querySelector<HTMLElement>('.dev');
      if (!intro || !stack || !fullstack || !dev) return;
      const columns = intro.querySelector<HTMLElement>('[data-intro-guide="columns"]');
      const rows = intro.querySelector<HTMLElement>('[data-intro-guide="rows"]');

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const nativeScroll = CSS.supports('animation-timeline', 'scroll(root block)')
        && CSS.supports('animation-range', '0px 100px');
      let frame = 0;
      let start = 0;
      let distance = 1;
      let width = window.innerWidth;
      let height = intro.offsetHeight;
      let progress = 0;
      let previousTime = 0;

      const targetProgress = () => reducedMotion.matches
          ? 0
          : Math.min(1, Math.max(0, (window.scrollY - start) / distance));

      const render = () => {
        // Slide horizontally in opposite directions as each word grows.
        fullstack.style.transform = `translate3d(${-width * 0.2 * progress}px, 0, 0) scale(${1 + 0.22 * progress})`;
        dev.style.transform = `translate3d(${width * 0.24 * progress}px, 0, 0) scale(${1 + 0.36 * progress})`;

        // Let the drafting guides drift gently behind the typography.
        if (columns) {
          columns.style.transform = `translate3d(${-width * 0.025 * progress}px, 0, 0)`;
        }
        if (rows) {
          rows.style.transform = `translate3d(${-width * 0.025 * progress}px, ${-height * 0.06 * progress}px, 0)`;
        }
      };

      // Older Safari versions deliver scroll events unevenly during touch inertia.
      // Follow their target on animation frames, including the gaps between events.
      const tick = (time: number) => {
        frame = 0;
        const target = targetProgress();
        const elapsed = previousTime ? Math.min(64, time - previousTime) : 16.67;
        previousTime = time;
        progress += (target - progress) * (1 - Math.exp(-elapsed / 60));
        if (reducedMotion.matches || Math.abs(target - progress) < 0.0001) progress = target;
        render();
        if (progress !== target) frame = requestAnimationFrame(tick);
        else previousTime = 0;
      };

      const schedule = () => {
        if (nativeScroll || frame) return;
        frame = requestAnimationFrame(tick);
      };

      const measure = () => {
        // Measure the stationary container, rather than the sticky intro.
        start = stack.getBoundingClientRect().top + window.scrollY;
        width = window.innerWidth;
        height = intro.offsetHeight;
        distance = Math.max(1, height * 0.85);
        if (nativeScroll) {
          intro.style.setProperty('--intro-width', `${width}px`);
          intro.style.setProperty('--intro-height', `${height}px`);
          intro.style.setProperty('--intro-scroll-start', `${start}px`);
          intro.style.setProperty('--intro-scroll-end', `${start + distance}px`);
          intro.setAttribute('data-native-intro', '');
        } else {
          progress = targetProgress();
          render();
        }
      };

      // iOS toolbar expansion fires resize events without changing the stable
      // viewport layout. Avoid resetting the fallback animation on those events.
      const resize = () => {
        if (window.innerWidth !== width || intro.offsetHeight !== height) measure();
      };

      const observer = new ResizeObserver(measure);
      observer.observe(intro);
      if (!nativeScroll) window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', resize);
      reducedMotion.addEventListener('change', schedule);
      measure();

      this.cleanup = () => {
        cancelAnimationFrame(frame);
        observer.disconnect();
        window.removeEventListener('scroll', schedule);
        window.removeEventListener('resize', resize);
        reducedMotion.removeEventListener('change', schedule);
        fullstack.style.removeProperty('transform');
        dev.style.removeProperty('transform');
        columns?.style.removeProperty('transform');
        rows?.style.removeProperty('transform');
        intro.removeAttribute('data-native-intro');
        for (const property of ['--intro-width', '--intro-height', '--intro-scroll-start', '--intro-scroll-end']) {
          intro.style.removeProperty(property);
        }
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('intro-title')) {
    customElements.define('intro-title', IntroTitle);
  }
</script>
