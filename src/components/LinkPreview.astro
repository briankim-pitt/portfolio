---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  label: string;
  title: string;
  description: string;
  site: string;
  image: ImageMetadata;
}

const { href, label, title, description, site, image } = Astro.props;
---

<div class="link-preview">
  <p class="label">{label}</p>
  <a class="preview-card" href={href}>
    <Image src={image} alt="" width={320} loading="lazy" />
    <span class="content">
      <span class="site">{site} <span aria-hidden="true">↗</span></span>
      <strong>{title}</strong>
      <span class="summary">{description}</span>
    </span>
  </a>
</div>

<style>
  .link-preview {
    margin-top: 1.5rem;
  }

  .label {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    color: #666;
  }

  .preview-card {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid #ddd;
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
  }

  .preview-card:hover {
    border-color: #888;
  }

  .preview-card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 1rem;
  }

  .site {
    display: flex;
    justify-content: space-between;
    width: 100%;
    color: #666;
    font-size: 0.7rem;
  }

  strong {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .summary {
    color: #666;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  @media (max-width: 28rem) {
    .preview-card {
      grid-template-columns: 1fr;
    }

    img {
      height: 9rem;
      object-fit: contain;
      background: #fafafa;
    }
  }
</style>
