---
import { Image } from 'astro:assets';
import profile from '../../assets/profile.JPG';

// Keep the middle clear; irregular edge tiles blend the photo into the page.
const tiles = Array.from({ length: 96 }, (_, index) => {
  const row = Math.floor(index / 8);
  const column = index % 8;
  const depth = Math.min(row, 11 - row, column, 7 - column);
  const pattern = (row * 7 + column * 11) % 9;

  if (depth > 1 || (depth === 1 && pattern > 3)) return null;

  return {
    row: row + 1,
    column: column + 1,
    minimum: depth === 0 && pattern < 5 ? 1 : 0,
    end: 0.66 + (pattern / 8) * 0.3,
  };
}).filter((tile) => tile !== null);
---

<profile-portrait>
  <Image
    class="portrait-image"
    src={profile}
    alt="My profile photo"
    width={480}
    widths={[240, 480, 720]}
    sizes="(max-width: 36rem) 208px, 256px"
    loading="eager"
    fetchpriority="high"
  />
  <div class="portrait-frame" aria-hidden="true">
    {tiles.map((tile) => (
      <span
        class="frame-tile"
        style={`grid-area: ${tile.row} / ${tile.column}; --tile-min: ${tile.minimum}; --tile-end: ${tile.end};`}
      />
    ))}
  </div>
</profile-portrait>

<script>
  class ProfilePortrait extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let frame = 0;
      let visible = true;

      const update = () => {
        frame = 0;

        if (reducedMotion.matches) {
          this.style.removeProperty('--scroll-progress');
          this.style.removeProperty('--parallax-y');
          return;
        }

        const bounds = this.getBoundingClientRect();
        const progress = Math.max(
          0,
          Math.min(1, (window.innerHeight - bounds.top) / (window.innerHeight + bounds.height)),
        );

        this.style.setProperty('--scroll-progress', progress.toFixed(4));
        this.style.setProperty('--parallax-y', `${((progress - 0.5) * 36).toFixed(2)}px`);
      };

      const schedule = () => {
        if (!frame && visible) frame = window.requestAnimationFrame(update);
      };

      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) schedule();
      });

      observer.observe(this);
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      reducedMotion.addEventListener('change', schedule);
      schedule();

      this.cleanup = () => {
        window.cancelAnimationFrame(frame);
        observer.disconnect();
        window.removeEventListener('scroll', schedule);
        window.removeEventListener('resize', schedule);
        reducedMotion.removeEventListener('change', schedule);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('profile-portrait')) {
    customElements.define('profile-portrait', ProfilePortrait);
  }
</script>

<style>
  profile-portrait {
    --scroll-progress: 0.64;
    --parallax-y: 0px;
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    isolation: isolate;
    background: var(--page-background);
  }

  .portrait-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate3d(0, var(--parallax-y), 0) scale(1.14);
    will-change: transform;
  }

  .portrait-frame {
    position: absolute;
    inset: -0.5px;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(12, 1fr);
    pointer-events: none;
  }

  .frame-tile {
    margin: -0.5px;
    background: var(--page-background);
    opacity: clamp(var(--tile-min), calc((var(--tile-end) - var(--scroll-progress)) * 5), 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait-image {
      transform: none;
      will-change: auto;
    }

    .frame-tile {
      opacity: clamp(var(--tile-min), calc((var(--tile-end) - 0.64) * 5), 1);
    }
  }
</style>
