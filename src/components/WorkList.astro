---
import { work } from '../data/work';
import TechStack from './TechStack.astro';
import LinkPreview from './LinkPreview.astro';
---

<div class="work-list">
  {work.map((item) => (
    <article class="work-item">
      <div>
        <p class="category">{item.category}</p>
        <h3><a href={item.href}>{item.title}</a></h3>
        {item.role && <p class="role">{item.role}</p>}
        {item.period && <p class="period">{item.period}</p>}
      </div>
      <div>
        <p class="description">{item.description}</p>
        <TechStack items={item.technologies} label={item.stackLabel} />
        {item.link?.preview ? (
          <LinkPreview href={item.link.href} label={item.link.label} {...item.link.preview} />
        ) : item.link && (
          <a class="detail-link" href={item.link.href}>
            {item.link.label} <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </article>
  ))}
</div>

<style>
  .work-list {
    margin-top: 2.5rem;
  }

  .work-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2.5rem;
    padding-block: 2.25rem;
  }

  .work-item:first-child {
    padding-top: 0;
  }

  .work-item:last-child {
    padding-bottom: 0;
  }

  .work-item + .work-item {
    border-top: 1px solid #eee;
  }

  .category {
    margin: 0 0 0.5rem;
    color: #666;
    font-size: 0.75rem;
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  .role,
  .period {
    margin: 0.6rem 0 0;
    color: #666;
    font-size: 0.8rem;
  }

  .description {
    max-width: 62ch;
    margin: 0;
    color: #444;
    line-height: 1.75;
  }

  a {
    color: inherit;
    text-underline-offset: 0.25em;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }

  .detail-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.85rem;
  }

  @media (max-width: 45rem) {
    .work-item {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
