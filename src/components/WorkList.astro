---
import { work } from '../data/work';
import TechStack from './TechStack.astro';
import LinkPreview from './LinkPreview.astro';
---

<magnetic-cards class="work-grid">
  {work.map((item, index) => (
    <div class="card-slot" data-enter style={`--enter-delay: ${(index % 2) * 60}ms`}>
      <article class="work-card">
        <div class="card-content">
          <div>
            <p class="category">{item.category}</p>
            <h3>
              <a href={item.href}>
                {item.logo ? (
                  <img class="project-logo" src={item.logo.src} width={item.logo.width} height={item.logo.height} alt={item.title} loading="lazy" />
                ) : item.title}
              </a>
            </h3>
            {item.role && <p class="role">{item.role}</p>}
            {item.period && <p class="period">{item.period}</p>}
          </div>
          <div>
            <p class="description">{item.description}</p>
            <TechStack items={item.technologies} label={item.stackLabel} />
            {item.link?.preview ? (
              <LinkPreview href={item.link.href} label={item.link.label} {...item.link.preview} />
            ) : item.link && (
              <a class="detail-link" href={item.link.href}>
                {item.link.label} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </article>
    </div>
  ))}
</magnetic-cards>

<script>
  class MagneticCards extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const cleanups = [...this.querySelectorAll<HTMLElement>('.card-slot')].map((slot) => {
        const card = slot.querySelector<HTMLElement>('.work-card');
        if (!card) return () => {};
        let frame = 0;
        let pointerX = 0;
        let pointerY = 0;

        const reset = () => {
          cancelAnimationFrame(frame);
          frame = 0;
          card.style.removeProperty('--magnet-x');
          card.style.removeProperty('--magnet-y');
        };

        const render = () => {
          frame = 0;
          // The frame stays fixed; only its inset content follows the pointer.
          const bounds = slot.getBoundingClientRect();
          const x = Math.max(-1, Math.min(1, (pointerX - bounds.left) / bounds.width * 2 - 1));
          const y = Math.max(-1, Math.min(1, (pointerY - bounds.top) / bounds.height * 2 - 1));
          card.style.setProperty('--magnet-x', `${x * 10}px`);
          card.style.setProperty('--magnet-y', `${y * 8}px`);
        };

        const move = (event: PointerEvent) => {
          if (!finePointer.matches || reducedMotion.matches || event.pointerType !== 'mouse') return;
          pointerX = event.clientX;
          pointerY = event.clientY;
          if (!frame) frame = requestAnimationFrame(render);
        };

        slot.addEventListener('pointermove', move, { passive: true });
        slot.addEventListener('pointerleave', reset);
        slot.addEventListener('pointercancel', reset);
        slot.addEventListener('focusin', reset);
        window.addEventListener('blur', reset);
        window.addEventListener('scroll', reset, { passive: true });
        finePointer.addEventListener('change', reset);
        reducedMotion.addEventListener('change', reset);

        return () => {
          reset();
          slot.removeEventListener('pointermove', move);
          slot.removeEventListener('pointerleave', reset);
          slot.removeEventListener('pointercancel', reset);
          slot.removeEventListener('focusin', reset);
          window.removeEventListener('blur', reset);
          window.removeEventListener('scroll', reset);
          finePointer.removeEventListener('change', reset);
          reducedMotion.removeEventListener('change', reset);
        };
      });
      this.cleanup = () => cleanups.forEach((cleanup) => cleanup());
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('magnetic-cards')) {
    customElements.define('magnetic-cards', MagneticCards);
  }
</script>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .card-slot {
    min-width: 0;
  }

  .work-card {
    container-type: inline-size;
    overflow: hidden;
    min-width: 0;
    height: 100%;
    padding: clamp(1.25rem, 2vw, 2rem);
    border: 1px solid var(--divider-subtle);
    border-radius: 0;
    background: #1b1b1b;
    box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
    transition: border-color 250ms ease, box-shadow 350ms ease;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-width: 0;
    height: 100%;
  }

  .work-card:focus-within {
    border-color: var(--focus-color);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card-content {
      transform: translate3d(var(--magnet-x, 0px), var(--magnet-y, 0px), 0);
      transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-slot:hover .work-card {
      border-color: #666;
      box-shadow: 0 18px 40px rgb(0 0 0 / 24%);
    }
  }

  .category {
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
  }

  h3 a {
    display: inline-block;
    max-width: 100%;
    text-decoration: none;
  }

  .project-logo {
    display: block;
    width: 10rem;
    max-width: 100%;
    height: auto;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  .role,
  .period {
    margin: 0.6rem 0 0;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .description {
    max-width: 62ch;
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  a {
    color: var(--link-color);
    text-underline-offset: 0.25em;
  }

  a:hover {
    color: var(--link-hover);
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }

  .detail-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.85rem;
  }

</style>
