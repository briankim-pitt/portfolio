---
import { Image } from 'astro:assets';
import { work } from '../data/work';
import TechStack from './TechStack.astro';
import WanderCartAsset from './WanderCartAsset.astro';

const previewWidths = (sourceWidth: number) => [...new Set([400, 800, 1200, 1600, Math.min(sourceWidth, 1600)])]
  .filter((width) => width <= sourceWidth)
  .sort((a, b) => a - b);
---

<magnetic-cards class="work-grid">
  {work.map((item, index) => (
    <div class="card-slot" data-enter>
      <article class="work-card">
        <a class:list={['project-visual', { 'sudo-preview': item.title === 'Surge AI' }]} href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.title === 'Surge AI' ? 'View sudo L7 blog post' : `Explore ${item.title}`}>
          <div class="card-content">
            {item.previewVideo ? (
              <video
                class="cover video-preview"
                src={item.previewVideo.src}
                width={item.previewVideo.width}
                height={item.previewVideo.height}
                muted
                loop
                playsinline
                preload="metadata"
                aria-hidden="true"
              />
            ) : item.link?.preview ? (
              <Image
                class="cover"
                src={item.link.preview.image}
                alt=""
                width={Math.min(1200, item.link.preview.image.width)}
                widths={previewWidths(item.link.preview.image.width)}
                sizes="(min-width: 56rem) 52vw, 100vw"
                loading="lazy"
              />
            ) : item.brand === 'wandercart' ? (
              <div class="wandercart-stage" aria-hidden="true">
                <WanderCartAsset variant="icon" class="wandercart-icon" />
                <span class="wip-note">work in progress</span>
              </div>
            ) : item.logo ? (
              <div class="brand-stage" aria-hidden="true">
                <div class="brand-sheet">
                  <img src={item.logo.src} width={item.logo.width} height={item.logo.height} alt="" loading="lazy" />
                  <span>{item.category}</span>
                </div>
              </div>
            ) : (
              <div class="document-stage" aria-hidden="true">
                <div class="document-back"></div>
                <div class="document-front">
                  <span class="document-label">Knowledge → Answers</span>
                  <span class="document-title">{item.title}</span>
                  <div class="document-footer"><span>Google Drive</span><span>Sources ↗</span></div>
                </div>
              </div>
            )}
            {item.title === 'Surge AI' && (
              <span class="preview-note" aria-hidden="true">View blog post <span>↗</span></span>
            )}
          </div>
        </a>
        <div class="project-body">
          <p class="project-index">{String(index + 1).padStart(3, '0')} / {item.category}</p>
          <div class="title-row">
            <h3>
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.brand === 'wandercart' ? (
                  <span class="wandercart-title">{item.title}</span>
                ) : item.logo ? (
                  <img class="project-logo" src={item.logo.src} width={item.logo.width} height={item.logo.height} alt={item.title} loading="lazy" />
                ) : item.title}
              </a>
            </h3>
          </div>
          {item.role && <p class="role">{item.role}</p>}
          {item.period && <p class="period">{item.period}</p>}
          <p class="description">{item.description}</p>
          <TechStack items={item.technologies} label={item.stackLabel} />
          {item.link && (
            <a class="detail-link" href={item.link.href} target="_blank" rel="noopener noreferrer">
              {item.link.label}<span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </article>
    </div>
  ))}
</magnetic-cards>

<script>
  class MagneticCards extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const magnetResets = new Set<() => void>();
      let scrolling = false;
      let scrollTimer = 0;

      const suspendMagnet = () => {
        if (!scrolling) {
          scrolling = true;
          for (const reset of magnetResets) reset();
        }
        window.clearTimeout(scrollTimer);
        // Native scroll events keep this suspended throughout Lenis's inertia.
        scrollTimer = window.setTimeout(() => { scrolling = false; }, 160);
      };

      const cleanups = [...this.querySelectorAll<HTMLElement>('.card-slot')].map((slot) => {
        const card = slot.querySelector<HTMLElement>('.work-card');
        const visual = slot.querySelector<HTMLElement>('.project-visual');
        if (!card || !visual) return () => {};
        let frame = 0;
        let pointerX = 0;
        let pointerY = 0;
        const video = slot.querySelector<HTMLVideoElement>('video');
        let videoInView = false;
        let videoHovered = false;

        const updatePlayback = () => {
          if (!video) return;
          if (videoHovered && videoInView && finePointer.matches && !document.hidden && !reducedMotion.matches) {
            void video.play().catch(() => {});
          } else {
            video.pause();
            if (!videoHovered) video.currentTime = 0;
          }
        };

        const videoObserver = video ? new IntersectionObserver(([entry]) => {
          videoInView = entry.isIntersecting;
          if (!videoInView) videoHovered = false;
          updatePlayback();
        }, { threshold: 0 }) : undefined;

        const playOnHover = (event: PointerEvent) => {
          videoHovered = event.pointerType === 'mouse';
          updatePlayback();
        };

        const stopHover = () => {
          videoHovered = false;
          updatePlayback();
        };

        if (video) {
          videoObserver?.observe(video);
          visual.addEventListener('pointerenter', playOnHover);
          visual.addEventListener('pointerleave', stopHover);
          visual.addEventListener('pointercancel', stopHover);
          window.addEventListener('blur', stopHover);
          document.addEventListener('visibilitychange', updatePlayback);
          finePointer.addEventListener('change', stopHover);
          reducedMotion.addEventListener('change', updatePlayback);
        }

        const reset = () => {
          cancelAnimationFrame(frame);
          frame = 0;
          card.style.removeProperty('--magnet-x');
          card.style.removeProperty('--magnet-y');
        };
        magnetResets.add(reset);

        const render = () => {
          frame = 0;
          if (scrolling) return;
          // Measure the stable link area while its media follows the pointer.
          const bounds = visual.getBoundingClientRect();
          const x = Math.max(-1, Math.min(1, (pointerX - bounds.left) / bounds.width * 2 - 1));
          const y = Math.max(-1, Math.min(1, (pointerY - bounds.top) / bounds.height * 2 - 1));
          card.style.setProperty('--magnet-x', `${x * 10}px`);
          card.style.setProperty('--magnet-y', `${y * 8}px`);
        };

        const move = (event: PointerEvent) => {
          if (scrolling || !finePointer.matches || reducedMotion.matches || event.pointerType !== 'mouse') return;
          if (event.clientX === pointerX && event.clientY === pointerY) return;
          pointerX = event.clientX;
          pointerY = event.clientY;
          if (!frame) frame = requestAnimationFrame(render);
        };

        visual.addEventListener('pointermove', move, { passive: true });
        visual.addEventListener('pointerleave', reset);
        visual.addEventListener('pointercancel', reset);
        visual.addEventListener('focusin', reset);
        window.addEventListener('blur', reset);
        finePointer.addEventListener('change', reset);
        reducedMotion.addEventListener('change', reset);

        return () => {
          reset();
          magnetResets.delete(reset);
          videoObserver?.disconnect();
          video?.pause();
          visual.removeEventListener('pointerenter', playOnHover);
          visual.removeEventListener('pointerleave', stopHover);
          visual.removeEventListener('pointercancel', stopHover);
          window.removeEventListener('blur', stopHover);
          document.removeEventListener('visibilitychange', updatePlayback);
          finePointer.removeEventListener('change', stopHover);
          reducedMotion.removeEventListener('change', updatePlayback);
          visual.removeEventListener('pointermove', move);
          visual.removeEventListener('pointerleave', reset);
          visual.removeEventListener('pointercancel', reset);
          visual.removeEventListener('focusin', reset);
          window.removeEventListener('blur', reset);
          finePointer.removeEventListener('change', reset);
          reducedMotion.removeEventListener('change', reset);
        };
      });
      window.addEventListener('wheel', suspendMagnet, { passive: true });
      window.addEventListener('scroll', suspendMagnet, { passive: true });

      this.cleanup = () => {
        window.clearTimeout(scrollTimer);
        window.removeEventListener('wheel', suspendMagnet);
        window.removeEventListener('scroll', suspendMagnet);
        cleanups.forEach((cleanup) => cleanup());
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('magnetic-cards')) {
    customElements.define('magnetic-cards', MagneticCards);
  }
</script>

<style>
  .project-index,
  .role,
  .period,
  .detail-link,
  .preview-note,
  .wip-note {
    font-family: var(--font-ui);
  }

  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(4rem, 10vw, 10rem);
  }

  .card-slot,
  .work-card {
    min-width: 0;
  }

  .work-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 6rem);
  }

  .project-body {
    grid-column: 1;
    grid-row: 1;
  }

  .project-visual {
    grid-column: 2;
    grid-row: 1;
  }

  .card-slot:nth-child(even) .work-card {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .card-slot:nth-child(even) .project-visual {
    grid-column: 1;
  }

  .card-slot:nth-child(even) .project-body {
    grid-column: 2;
  }

  .project-visual {
    position: relative;
    --focus-color: #fff;
    display: block;
    min-width: 0;
    text-decoration: none;
  }

  .card-content {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    pointer-events: none;
    filter: grayscale(1);
    transition: filter 600ms ease;
  }

  .sudo-preview {
    width: 75%;
    justify-self: center;
  }

  .preview-note {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    background: rgb(15 15 15 / 85%);
    color: #fff;
    font-size: 0.85rem;
    line-height: 1.4;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 250ms ease, transform 250ms ease;
  }

  .sudo-preview:is(:hover, :focus-visible) .preview-note {
    opacity: 1;
    transform: translateY(0);
  }

  .project-visual:is(:hover, :focus-visible) .card-content {
    filter: grayscale(0);
  }

  .cover {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 0;
    object-fit: contain;
  }

  .sudo-preview .cover {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center;
  }

  .video-preview {
    max-height: 80svh;
  }

  .project-body {
    min-width: 0;
    padding: clamp(0rem, 1vw, 1rem);
  }

  .project-index {
    margin: 0 0 clamp(1.25rem, 3vw, 2.5rem);
    color: var(--accent-color);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  h3 {
    margin: 0;
    font-size: clamp(2.25rem, 4.7vw, 5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  h3 a {
    display: inline-block;
    max-width: 100%;
    text-decoration: none;
  }

  .project-logo {
    display: block;
    width: clamp(12rem, 24vw, 25rem);
    max-width: 100%;
    height: auto;
    filter: grayscale(1);
    transition: filter 600ms ease;
  }

  h3 a:is(:hover, :focus-visible) .project-logo {
    filter: grayscale(0);
  }

  .wandercart-title {
    text-transform: none;
  }

  .wandercart-stage {
    display: grid;
    place-items: center;
    gap: 1rem;
    width: 100%;
    padding-block: clamp(1rem, 3vw, 3rem);
  }

  .wandercart-icon {
    display: block;
    width: clamp(4.032rem, 8.512vw, 8.96rem);
    max-width: 26.88%;
    height: auto;
    border-radius: 27%;
  }

  .wip-note {
    color: #888;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  .role,
  .period {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .period {
    margin-top: 0.15rem;
  }

  .description {
    max-width: 48ch;
    margin: 1.5rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.65;
  }

  a {
    color: var(--link-color);
    text-underline-offset: 0.25em;
  }

  a:hover {
    color: var(--link-hover);
  }

  a:focus-visible {
    outline: 2px solid var(--focus-color);
    outline-offset: 5px;
  }

  .detail-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--divider-color);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .detail-link span {
    font-size: 1.2rem;
  }

  .document-stage {
    position: relative;
    width: 72%;
    max-width: 30rem;
    transform: rotate(-5deg) translateY(1.25rem);
  }

  .document-back {
    position: absolute;
    inset: -0.7rem 0.7rem 0.7rem -0.7rem;
    background: #788391;
    transform: rotate(-5deg);
  }

  .document-front {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1rem, 3vw, 2rem);
    background: #dce1e8;
    color: #252b34;
    box-shadow: 0 15px 30px #0005;
  }

  .document-label {
    font-size: 0.55rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .document-title {
    max-width: 14ch;
    font-size: clamp(1.2rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .document-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid #252b3433;
    font-size: 0.6rem;
  }

  .brand-stage {
    width: 72%;
    max-width: 30rem;
    transform: rotate(5deg) translateY(1rem);
  }

  .brand-sheet {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    min-height: 10rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: #242128;
    box-shadow: -8px 8px 0 #51495f, -16px 16px 0 #36313f, 0 24px 32px #0005;
  }

  .brand-sheet img {
    width: 100%;
    max-width: 15rem;
    height: auto;
  }

  .brand-sheet > span {
    color: var(--text-muted);
    font-size: 0.65rem;
    letter-spacing: 0.03em;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card-content {
      transform: translate3d(var(--magnet-x, 0px), var(--magnet-y, 0px), 0);
      transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1), filter 600ms ease;
    }

  }

  @media (max-width: 55.99rem) {
    .work-grid {
      gap: 4.5rem;
    }

    .work-card,
    .card-slot:nth-child(even) .work-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .project-visual,
    .card-slot:nth-child(even) .project-visual {
      grid-column: 1;
      grid-row: 1;
    }

    .project-body,
    .card-slot:nth-child(even) .project-body {
      grid-column: 1;
      grid-row: 2;
      padding: 0;
    }

    .project-logo {
      width: clamp(12rem, 45vw, 20rem);
    }

    .wandercart-icon {
      width: 18.816%;
    }

    .document-title {
      font-size: clamp(1.2rem, 5vw, 2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-visual,
    .card-content,
    .project-logo,
    .preview-note {
      transition: none;
    }
  }

  @media (hover: none) {
    .card-content,
    .project-logo {
      filter: none;
    }
  }
</style>
