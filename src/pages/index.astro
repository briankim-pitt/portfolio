---
import Layout from '../layouts/Layout.astro';
import WorkList from '../components/WorkList.astro';
import FolioStack from '../components/FolioStack.astro';
import IntroTitle from '../components/IntroTitle.astro';
import IntroGuides from '../components/IntroGuides.astro';
---

<Layout title="brian kim">
  <h1 class="site-name">BRIAN KIM</h1>
  <nav class="site-nav" aria-label="Main navigation">
    <a href="#dev-work">PORTFOLIO</a>
    <a href="#contact">CONTACT</a>
  </nav>
  <div class="portfolio">
    <main id="about">
      <header class="intro" data-base-layer>
        <IntroGuides />
        <IntroTitle />
      </header>

      <section class="folio dev-work" data-content-layer aria-labelledby="dev-work">
        <header class="section-heading">
          <h2 id="dev-work" data-enter>
            <span>PROJECTS</span>
            <span class="project-year"><span class="year-apostrophe">'</span>26</span>
          </h2>
          <p data-enter style="--enter-delay: 60ms">Selected projects and work.</p>
          <ul class="links" aria-label="Work profiles" data-enter style="--enter-delay: 120ms">
            <li><a href="https://github.com/briankim-pitt">GitHub</a></li>
            <li><a href="https://www.linkedin.com/in/br-kim/">LinkedIn</a></li>
          </ul>
        </header>
        <div class="section-content">
          <WorkList />
        </div>
      </section>

      <!-- A flow anchor reaches the final layer even while it is waiting below the viewport. -->
      <div id="contact" class="contact-anchor" aria-hidden="true"></div>
      <div class="contact-layer">
        <section class="folio contact-folio" aria-labelledby="contact-title" data-cursor-invert>
          <header class="section-heading">
            <h2 id="contact-title" data-enter>CONTACT</h2>
            <p data-enter style="--enter-delay: 60ms">Have a project in mind? Let’s talk.</p>
          </header>
          <div class="section-content contact-details">
            <a class="contact-email" href="mailto:bri_kim@icloud.com" data-enter>
              <span>bri_kim@icloud.com</span><span aria-hidden="true">↗</span>
            </a>
            <ul class="links" aria-label="Social profiles" data-enter style="--enter-delay: 60ms">
              <li><a href="https://github.com/briankim-pitt">GitHub ↗</a></li>
              <li><a href="https://www.linkedin.com/in/br-kim/">LinkedIn ↗</a></li>
            </ul>
          </div>
        </section>
      </div>
      <FolioStack />
    </main>
  </div>
</Layout>

<style>
  .portfolio {
    --page-gutter: clamp(1rem, 2vw, 2rem);
    background: var(--page-background);
  }

  main {
    position: relative;
    isolation: isolate;
  }

  main[data-stack-ready]::after {
    content: '';
    display: block;
    height: var(--contact-height);
  }

  .contact-layer {
    position: relative;
    z-index: 2;
  }

  main[data-stack-ready] .contact-layer {
    position: absolute;
    top: calc(var(--intro-height) - 2rem);
    bottom: 0;
    inset-inline: 0;
    pointer-events: none;
  }

  main[data-stack-ready] .dev-work {
    position: sticky;
    top: calc(100svh - 2rem - var(--dev-height));
    transform: translate3d(0, var(--dev-stop-offset, 0px), 0);
  }

  main[data-stack-ready] .contact-folio {
    position: sticky;
    top: calc(100svh - 2rem);
    margin-top: 0;
    pointer-events: auto;
  }

  .intro {
    position: sticky;
    top: 0;
    z-index: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    min-height: 100svh;
    padding: clamp(3rem, 10vh, 7rem) var(--page-gutter);
    background: var(--page-background);
    overflow: clip;
  }

  .site-name {
    position: fixed;
    z-index: 10;
    top: max(clamp(1rem, 2vw, 2rem), env(safe-area-inset-top));
    left: max(clamp(1rem, 2vw, 2rem), env(safe-area-inset-left));
    max-width: 14ch;
    margin: 0;
    font-size: calc(clamp(1.875rem, 4.5vw, 3rem) - 1.5pt);
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .site-nav {
    position: fixed;
    z-index: 10;
    top: max(clamp(1rem, 2vw, 2rem), env(safe-area-inset-top));
    right: max(clamp(1rem, 2vw, 2rem), env(safe-area-inset-right));
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    min-height: calc((clamp(1.875rem, 4.5vw, 3rem) - 1.5pt) * 1.1);
    color: #fff;
    mix-blend-mode: difference;
  }

  .site-nav a {
    color: inherit;
    padding-block: 0.5rem;
    font-size: clamp(0.7rem, 1.2vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: inherit;
    text-decoration: underline;
  }

  .folio {
    --folio-background: var(--panel-background);
    --text-primary: #fff;
    --text-secondary: #f0f0f0;
    --text-muted: #c2c2c2;
    --divider-color: #484848;
    --divider-subtle: #3b3b3b;
    --link-color: #fff;
    --link-hover: #b8c7ff;
    --focus-color: #9cb2ff;
    --preview-background: #2c2c2c;
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    margin-top: -2rem;
    padding: clamp(3rem, 6vw, 5rem) var(--page-gutter) clamp(4rem, 10vh, 7rem);
    background: var(--folio-background);
    border-radius: 0;
    color: var(--text-primary);
    box-shadow: 0 -1rem 4rem rgb(0 0 0 / 16%);
  }

  .dev-work {
    margin-top: -4rem;
    background-image: radial-gradient(circle, #3a3a3a 1px, transparent 1.5px);
    background-size: 12.5vw 12.5vw;
  }

  #dev-work {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    color: #262626;
    font-size: clamp(4.74045rem, 16.0446vw, 13.1274rem);
    letter-spacing: 0.02em;
  }

  .project-year {
    flex-shrink: 0;
    margin-left: auto;
    text-align: right;
    white-space: nowrap;
  }

  .year-apostrophe {
    color: var(--accent-color);
  }

  @media (max-width: 36rem) {
    #dev-work {
      font-size: 13.75vw;
    }
  }

  .contact-folio {
    --folio-background: var(--accent-color);
    --link-hover: #fff;
    z-index: 2;
    min-height: 100svh;
    align-content: space-between;
    padding-top: clamp(6rem, 10vh, 8rem);
  }

  .contact-anchor {
    height: 0;
  }

  .section-content {
    min-width: 0;
  }

  h2 {
    margin: 0 0 clamp(2rem, 6vw, 5rem);
    font-size: clamp(4.225rem, 14.3vw, 11.7rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-align: left;
    scroll-margin-top: 2rem;
  }

  a {
    color: var(--link-color);
    text-underline-offset: 0.25em;
  }

  a:hover {
    color: var(--link-hover);
    text-decoration-thickness: 2px;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .contact-email {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 40%);
    font-size: clamp(1.4rem, 6vw, 6rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .contact-email:hover span:first-child {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .contact-details .links {
    margin: 2rem 0 0;
  }
</style>
