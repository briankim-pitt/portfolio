---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import WorkList from '../components/WorkList.astro';
import FolioStack from '../components/FolioStack.astro';
import artwork1 from '../../assets/Untitled_Artwork.png';
import artwork2 from '../../assets/Untitled_Artwork 2.png';
import artwork3 from '../../assets/Untitled_Artwork 3.png';
import artwork4 from '../../assets/Untitled_Artwork 4.png';
import artwork5 from '../../assets/Untitled_Artwork 5.png';
import artwork6 from '../../assets/Untitled_Artwork 6.png';

const artworks = [
  { src: artwork1, alt: 'Painting of a black cat resting in a blue window surrounded by white blossoms.' },
  { src: artwork2, alt: 'Painting of pink evening clouds over the sea, with reeds in the foreground.' },
  { src: artwork3, alt: 'Painting of a lighthouse on a rocky shore under a pale moon.' },
  { src: artwork4, alt: 'Painting of the sun setting over a quiet beach.' },
  { src: artwork5, alt: 'Painting of a winding stream through green fields beneath distant mountains.' },
  { src: artwork6, alt: 'Painting of a person sitting beside water at night, surrounded by warm reflections.' },
];
---

<Layout title="brian kim">
  <div class="portfolio">
    <main id="about">
      <header class="intro" data-base-layer>
        <div>
          <p class="eyebrow" data-enter>Personal portfolio</p>
          <h1 data-enter style="--enter-delay: 60ms">brian kim</h1>
          <p data-enter style="--enter-delay: 120ms">Dev work, artwork, and ideas along the way.</p>
          <p data-enter style="--enter-delay: 180ms"><a href="mailto:bri_kim@icloud.com">bri_kim@icloud.com</a></p>
        </div>
      </header>

      <section class="folio dev-work" data-content-layer aria-labelledby="dev-work">
        <header class="section-heading">
          <h2 id="dev-work" data-enter>Dev Work</h2>
          <p data-enter style="--enter-delay: 60ms">Selected projects and work.</p>
          <ul class="links" aria-label="Work profiles" data-enter style="--enter-delay: 120ms">
            <li><a href="https://github.com/briankim-pitt">GitHub</a></li>
            <li><a href="https://www.linkedin.com/in/br-kim/">LinkedIn</a></li>
          </ul>
        </header>
        <div class="section-content">
          <WorkList />
        </div>
      </section>

      <div class="artwork-layer">
        <section class="folio artwork-folio" aria-labelledby="artwork">
          <header class="section-heading">
            <h2 id="artwork" data-enter>Artwork</h2>
            <p data-enter style="--enter-delay: 60ms">A space for my visual work.</p>
          </header>
          <div class="section-content gallery">
            {artworks.map((artwork, index) => (
              <figure class="art-frame" data-enter style={`--enter-delay: ${(index % 2) * 80}ms`}>
                <Image
                  src={artwork.src}
                  alt={artwork.alt}
                  width={720}
                  widths={[360, 720, 1080, 1440]}
                  sizes="(max-width: 36rem) calc(100vw - 4rem), 50vw"
                  loading="lazy"
                />
              </figure>
            ))}
          </div>
        </section>
      </div>
      <FolioStack />
    </main>
  </div>
</Layout>

<style>
  .portfolio {
    --page-gutter: clamp(1rem, 2vw, 2rem);
    background: var(--page-background);
  }

  main {
    position: relative;
    isolation: isolate;
  }

  main[data-stack-ready]::after {
    content: '';
    display: block;
    height: var(--artwork-height);
  }

  .artwork-layer {
    position: relative;
    z-index: 2;
  }

  main[data-stack-ready] .artwork-layer {
    position: absolute;
    top: calc(var(--intro-height) - 2rem);
    bottom: 0;
    inset-inline: 0;
    pointer-events: none;
  }

  main[data-stack-ready] .dev-work {
    position: sticky;
    top: calc(100svh - 2rem - var(--dev-height));
    transform: translate3d(0, var(--dev-stop-offset, 0px), 0);
  }

  main[data-stack-ready] .artwork-folio {
    position: sticky;
    top: calc(100svh - 2rem);
    margin-top: 0;
    pointer-events: auto;
  }

  .intro {
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    min-height: 100svh;
    padding: clamp(3rem, 10vh, 7rem) var(--page-gutter);
    background: var(--page-background);
  }

  .eyebrow {
    color: var(--accent-color);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin-block: 1.5rem;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .folio {
    --folio-background: var(--panel-background);
    --text-primary: #fff;
    --text-secondary: #f0f0f0;
    --text-muted: #c2c2c2;
    --divider-color: #484848;
    --divider-subtle: #3b3b3b;
    --link-color: #fff;
    --link-hover: #b8c7ff;
    --focus-color: #9cb2ff;
    --preview-background: #2c2c2c;
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    margin-top: -2rem;
    padding: clamp(3rem, 6vw, 5rem) var(--page-gutter) clamp(4rem, 10vh, 7rem);
    background: var(--folio-background);
    border-radius: 0;
    color: var(--text-primary);
    box-shadow: 0 -1rem 4rem rgb(0 0 0 / 16%);
  }

  .dev-work {
    margin-top: -4rem;
    background-image: radial-gradient(circle, #3a3a3a 1px, transparent 1.5px);
    background-size: 12.5vw 12.5vw;
  }

  .artwork-folio {
    --folio-background: var(--accent-color);
    --link-hover: #fff;
    z-index: 2;
  }

  .section-content {
    min-width: 0;
  }

  h2 {
    margin: 0 0 clamp(2rem, 6vw, 5rem);
    font-size: clamp(4.225rem, 14.3vw, 11.7rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-align: left;
    scroll-margin-top: 2rem;
  }

  a {
    color: var(--link-color);
    text-underline-offset: 0.25em;
  }

  a:hover {
    color: var(--link-hover);
    text-decoration-thickness: 2px;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 2rem;
  }

  .art-frame {
    margin: 0;
    padding: clamp(0.75rem, 1.5vw, 1.5rem);
    border: 0;
    border-radius: 0;
    background: #fff;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 48rem) and (min-height: 40rem) {
    .intro {
      position: sticky;
      top: 0;
    }
  }

  @media (max-width: 36rem) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
