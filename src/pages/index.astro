---
import Layout from '../layouts/Layout.astro';
---

<Layout title="My Portfolio">
  <main>
    <p class="eyebrow">Personal portfolio</p>
    <h1>A little space for what I make.</h1>
    <p>Projects, ideas, and a bit about me. Coming soon.</p>
  </main>
</Layout>

<style>
  main {
    width: min(100% - 3rem, 48rem);
    margin-inline: auto;
    padding-block: clamp(5rem, 18vh, 12rem);
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin-block: 1.5rem;
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
</style>
